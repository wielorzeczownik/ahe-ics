{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wielorzeczownik/.github"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README(\\.pl)?\\.md$/"],
      "matchStrings": ["python:(?<currentValue>[^\\s\"']+)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["rust"],
      "groupName": "rust base image"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["README.md", "README.pl.md"],
      "semanticCommitType": "docs"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde", "serde_json"],
      "groupName": "serde"
    }
  ]
}
