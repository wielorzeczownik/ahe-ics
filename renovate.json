{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:monorepos", "group:recommended"],
  "platformAutomerge": true,
  "automergeType": "pr",
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^README(\\.pl)?\\.md$"],
      "matchStrings": ["python:(?<currentValue>[^\\s\"']+)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.yml$"],
      "matchStrings": ["prettier@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "prettier",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["buildDependencies"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["dockerfile"],
      "pinDigests": true,
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["rust"],
      "groupName": "rust base image"
    },
    {
      "matchManagers": ["dockerfile"],
      "pinDigests": true,
      "matchPackageNames": ["debian"],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["README.md", "README.pl.md"],
      "semanticCommitType": "docs"
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["Dockerfile"],
      "semanticCommitType": "build",
      "groupName": "debian packages"
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["Dockerfile.alpine"],
      "semanticCommitType": "build",
      "groupName": "alpine packages"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "docker/build-push-action",
        "docker/login-action",
        "docker/metadata-action",
        "docker/setup-buildx-action",
        "docker/setup-qemu-action"
      ],
      "groupName": "docker actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact"
      ],
      "groupName": "artifact actions"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde", "serde_json"],
      "groupName": "serde"
    }
  ]
}
