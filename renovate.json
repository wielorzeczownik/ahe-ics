{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wielorzeczownik/.github"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^README(\\.pl)?\\.md$"],
      "matchStrings": ["python:(?<currentValue>[^\\s\"']+)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": ["buildDependencies"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["dockerfile"],
      "pinDigests": true,
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["rust"],
      "groupName": "rust base image"
    },
    {
      "matchManagers": ["dockerfile"],
      "pinDigests": true,
      "matchPackageNames": ["debian"],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["README.md", "README.pl.md"],
      "semanticCommitType": "docs"
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["Dockerfile"],
      "semanticCommitType": "build",
      "groupName": "debian packages"
    },
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["Dockerfile.alpine"],
      "semanticCommitType": "build",
      "groupName": "alpine packages"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "docker/build-push-action",
        "docker/login-action",
        "docker/metadata-action",
        "docker/setup-buildx-action",
        "docker/setup-qemu-action"
      ],
      "groupName": "docker actions"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde", "serde_json"],
      "groupName": "serde"
    }
  ]
}
